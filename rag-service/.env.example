RAG_SERVICE_TOKEN=
RAG_INDEX_BACKEND=memory
RAG_INDEX_PATH=../.runtime/rag-index.json
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_DIMENSIONS=384
# extractive: return source excerpts with citations, without any Chat Model.
# disabled: generation unavailable. openai-compatible: requires an approved model endpoint.
RAG_CHAT_PROVIDER=extractive
RAG_ANSWER_MODE=extractive
RAG_CHAT_TIMEOUT_SECONDS=25
RAG_CHAT_BASE_URL=
RAG_CHAT_API_KEY=
RAG_CHAT_MODEL=
RAG_ES_URL=
RAG_ES_INDEX=rag-document-chunks
RAG_MIN_EVIDENCE_SCORE=0.12
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
